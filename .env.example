# Supabase — create a free project at https://supabase.com/dashboard, then
# Project Settings → API for these three values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — server-only, never exposed to the browser. Keep this secret.
SUPABASE_SERVICE_ROLE_KEY=

# Resend — create a free account at https://resend.com for booking confirmation emails.
RESEND_API_KEY=
# Optional: defaults to Resend's shared test sender until the shop has its own domain verified.
RESEND_FROM_EMAIL="Joe's Barbershop <onboarding@resend.dev>"
